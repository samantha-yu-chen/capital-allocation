{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "verbatimModuleSyntax": true,
    "skipLibCheck": true, "resolveJsonModule": true, "outDir": "build",
    "rootDir": ".", "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "tests"]
}
