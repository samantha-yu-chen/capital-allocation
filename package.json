    "ledger": "tsc -p tsconfig.build.json && node build/src/presentation/cli/ledger-example.js",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": { "react": "19.2.0", "react-dom": "19.2.0", "zod": "4.1.12" },
  "devDependencies": { "@types/node": "24.10.0", "@types/react": "19.2.2", "@types/react-dom": "19.2.2", "typescript": "5.9.3", "vite": "7.3.6" }
}
